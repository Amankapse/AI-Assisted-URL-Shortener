# Spring
SPRING_PROFILES_ACTIVE=prod
PORT=8080
APP_PUBLIC_BASE_URL=https://<SERVICE>.onrender.com

# PostgreSQL / Neon
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_HOST>/<DATABASE>?sslmode=require
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=900000

# Redis / Render Key Value
SPRING_DATA_REDIS_URL=<RENDER_KEY_VALUE_INTERNAL_URL>
SPRING_REDIS_TIMEOUT=2s
APP_REDIRECT_CACHE_ENABLED=true
APP_REDIRECT_CACHE_TTL=10m
APP_REDIRECT_CACHE_INELIGIBLE_TTL=30s
APP_REDIRECT_CACHE_JITTER=30s
APP_REDIRECT_CACHE_SINGLE_FLIGHT_TIMEOUT=2s
APP_REDIRECT_CACHE_SINGLE_FLIGHT_CAPACITY=1024

# JWT
APP_AUTH_ISSUER=https://<SERVICE>.onrender.com
APP_AUTH_AUDIENCE=url-shortener-api
APP_AUTH_KEY_ID=prod-key-1
APP_AUTH_PRIVATE_KEY_PEM=<MULTILINE_PKCS8_PRIVATE_KEY_PEM_WITH_ESCAPED_NEWLINES>
APP_AUTH_PUBLIC_KEY_PEM=<MULTILINE_X509_PUBLIC_KEY_PEM_WITH_ESCAPED_NEWLINES>
APP_AUTH_ACCESS_TOKEN_TTL=15m
APP_AUTH_REFRESH_TOKEN_TTL=14d
APP_AUTH_SECURE_COOKIES=true

# Analytics privacy
APP_ANALYTICS_PUBLISHER=local
APP_ANALYTICS_IP_HASH_PEPPER=<STRONG_RANDOM_SECRET>
APP_ANALYTICS_QUEUE_CAPACITY=1000
APP_ANALYTICS_BATCH_SIZE=100
APP_ANALYTICS_FLUSH_INTERVAL=1s
APP_ANALYTICS_OFFER_TIMEOUT=10ms
APP_ANALYTICS_SHUTDOWN_FLUSH_TIMEOUT=5s
APP_ANALYTICS_RETRY_COUNT=2
APP_ANALYTICS_TOP_LINKS_MAX=25

# Idempotency
APP_IDEMPOTENCY_RETENTION=24h
APP_IDEMPOTENCY_CLEANUP_INTERVAL=1h

# Audit trail
APP_AUDIT_METADATA_MAX_BYTES=4096
APP_AUDIT_RETENTION=3650d

# API keys
APP_API_KEY_HASH_PEPPER=<STRONG_RANDOM_SECRET>
APP_API_KEY_DEFAULT_EXPIRY=90d
APP_API_KEY_MAX_EXPIRY=365d
APP_API_KEY_LAST_USED_UPDATE_INTERVAL=15m
APP_API_KEY_MAX_HEADER_LENGTH=256

# Transactional outbox
APP_OUTBOX_ENABLED=true
APP_OUTBOX_BATCH_SIZE=25
APP_OUTBOX_POLL_INTERVAL=1s
APP_OUTBOX_WORKERS=1
APP_OUTBOX_MAX_ATTEMPTS=5
APP_OUTBOX_BASE_BACKOFF=1s
APP_OUTBOX_MAX_BACKOFF=1m
APP_OUTBOX_CLAIM_TIMEOUT=5m
APP_OUTBOX_RETENTION=7d
APP_OUTBOX_CLEANUP_INTERVAL=1h
APP_OUTBOX_CLEANUP_BATCH_SIZE=500
APP_OUTBOX_MAX_PAYLOAD_BYTES=8192
APP_OUTBOX_SHUTDOWN_GRACE_PERIOD=10s
APP_OUTBOX_METRICS_REFRESH_INTERVAL=30s

# CORS
APP_AUTH_ALLOWED_ORIGINS=https://<FRONTEND_DOMAIN>

# Short-code configuration
SHORTENER_CODE_LENGTH=8
SHORTENER_CODE_MAX_RETRIES=5

# Quotas
SHORTENER_QUOTA_ENABLED=true
SHORTENER_QUOTA_DAILY_CREATIONS_PER_USER=10000
SHORTENER_QUOTA_MAX_ACTIVE_LINKS_PER_USER=100000
SHORTENER_QUOTA_DAILY_CUSTOM_ALIASES_PER_USER=1000

# Campaigns, tags, and URL search
APP_TAG_MAX_LENGTH=50
APP_TAGS_PER_URL=10
APP_CAMPAIGN_NAME_MAX_LENGTH=120
APP_CAMPAIGN_DESCRIPTION_MAX_LENGTH=500
APP_SEARCH_QUERY_MAX_LENGTH=100
APP_URL_SEARCH_DEFAULT_PAGE_SIZE=20
APP_URL_SEARCH_MAX_PAGE_SIZE=100

# Rate limits
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_KEY_SALT=<STRONG_RANDOM_SECRET>
APP_RATE_LIMIT_REDIS_TIMEOUT=250ms
APP_RATE_LIMIT_REGISTRATION_LIMIT=5
APP_RATE_LIMIT_REGISTRATION_WINDOW=1m
APP_RATE_LIMIT_LOGIN_LIMIT=5
APP_RATE_LIMIT_LOGIN_WINDOW=1m
APP_RATE_LIMIT_REFRESH_LIMIT=30
APP_RATE_LIMIT_REFRESH_WINDOW=1m
APP_RATE_LIMIT_URL_CREATE_LIMIT=60
APP_RATE_LIMIT_URL_CREATE_WINDOW=1m
APP_RATE_LIMIT_REDIRECT_LIMIT=600
APP_RATE_LIMIT_REDIRECT_WINDOW=1m
APP_RATE_LIMIT_ADMIN_ANALYTICS_LIMIT=120
APP_RATE_LIMIT_ADMIN_ANALYTICS_WINDOW=1m
APP_RATE_LIMIT_API_KEY_REQUESTS=600
APP_RATE_LIMIT_API_KEY_WINDOW=1m

# JVM / deployment
JAVA_TOOL_OPTIONS=-Xms64m -Xmx320m -XX:+UseG1GC
SERVER_MAX_HTTP_FORM_POST_SIZE=2MB
SERVER_MAX_SWALLOW_SIZE=2MB

# Frontend public runtime config for packaged single Web Service deployment
# Browser-visible values only; never put secrets here.
FRONTEND_API_BASE_URL=
FRONTEND_PUBLIC_SHORT_URL_BASE=https://<BACKEND_SERVICE>.onrender.com
FRONTEND_ENVIRONMENT=production
